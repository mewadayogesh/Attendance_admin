# Copy this file to ".env" (same folder as app.py) and fill in real values.
# Never commit the real ".env" file to git — add ".env" to .gitignore.

# Optional: Flask session secret key. Falls back to a dev default if unset.
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Required for the "Email Attendance Report" feature.
# MAIL_SENDER_PASSWORD must be a Gmail "App Password" (16 characters,
# generated under Google Account > Security > 2-Step Verification > App
# Passwords) — NOT your normal Gmail login password.
MAIL_SENDER_EMAIL=digitalcrest781@gmail.com
MAIL_SENDER_PASSWORD=your-16-char-app-password
MAIL_RECIPIENT_EMAIL=ymewada6262@gmail.com
